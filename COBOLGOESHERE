# generate_sample_data.py
import numpy as np

def generate_sample_data(filename="images.dat", num_samples=100):
    """Generate sample digit data for testing"""
    with open(filename, 'w') as f:
        for i in range(num_samples):
            # Random label (0-9)
            label = np.random.randint(0, 10)
            
            # Random pixel data (simplified)
            pixels = np.random.randint(0, 256, 784)
            pixel_str = ''.join([str(p) + ',' for p in pixels])[:-1]
            
            f.write(f"{label},{pixel_str}\n")
    
    print(f"Generated {num_samples} sample records in {filename}")

if __name__ == "__main__":
    generate_sample_data()










